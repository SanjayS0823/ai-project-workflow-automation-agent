[TEMPLATE]
# Copy this file to `.env` and fill in real values.
# Never commit `.env` to version control.

# ---- Backend ----
# Port the FastAPI/uvicorn server listens on.
BACKEND_PORT=8000

# SQLite database file used by the backend.
# Relative paths resolve against the directory uvicorn is started from.
DATABASE_URL=sqlite:///./app.db

# ---- AI (Phase 4) ----
# API key for the LLM provider used by the AI planning service.
# AI_LLM_API_KEY=

# Base URL for OpenAI-compatible chat completions API.
# AI_LLM_BASE_URL=https://api.openai.com/v1

# Model name used for planning.
# AI_LLM_MODEL=gpt-4o-mini

# Timeout (seconds) for a single AI planning request.
# AI_LLM_TIMEOUT_SECONDS=60

# Set to 1 to use the deterministic development fallback planner instead of
# the real AI. Useful for local testing without an API key.
# AI_USE_FALLBACK=1

# ---- GitHub (Phase 12, optional) ----
# Personal access token with `repo` scope, used to create issues from tasks.
# Issues are only ever created after explicit user confirmation.
# GITHUB_TOKEN=

# Sandbox/test repository in "owner/name" form.
# GITHUB_REPO=zeneralabs/sandbox

# Optional: override the GitHub API base URL (e.g. GitHub Enterprise).
# GITHUB_API_BASE_URL=https://api.github.com
